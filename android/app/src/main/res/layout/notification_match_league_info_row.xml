<?xml version="1.0" encoding="utf-8"?>
<!-- Display-only row for CT League — no tap targets, unlike the interactive court row.
     Result entry for League stays in-app (score steppers), so this is purely informational:
     which flagged-live match is on which court, nothing to tap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#1A6366F1"
    android:padding="8dp"
    android:layout_marginBottom="3dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mm_league_court_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A5B4FC"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:text="COURT 1 · GROUP A" />

        <TextView
            android:id="@+id/mm_league_teams_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#F5F5FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Team A vs Team B" />

    </LinearLayout>

    <TextView
        android:id="@+id/mm_league_live_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#FCA5A5"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:text="🔴 LIVE" />

</LinearLayout>
