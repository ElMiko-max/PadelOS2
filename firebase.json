{
     "functions": {
       "source": "functions"
     },
     "firestore": {
       "rules": "firestore.rules"
     },
     "storage": {
       "rules": "storage.rules"
     },
     "hosting": {
       "public": "dist",
       "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
       "headers": [
         {
           "source": "/releases/**",
           "headers": [
             { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
             { "key": "Access-Control-Allow-Origin", "value": "*" }
           ]
         }
       ]
     }
   }
