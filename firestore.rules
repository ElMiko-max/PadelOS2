rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /padelos/{document} {
      allow read, write: if request.auth != null;
    }
    // comms-split migration — replaces the old single padelos/comms blob. Unlike that blob
    // (one opaque JSON string, rules could only say "any signed-in user may write here"), real
    // fields mean real structural guards are possible for the first time: a write can never
    // silently reassign an event to a different community, or claim a mismatched id. Full
    // membership-scoped rules (only this community's own admins can write it) are a further step
    // — not yet done, tracked as a stretch goal in PLAN — these are the cheap, unconditional wins.
    match /padelos_communities/{communityId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.id == int(communityId);
      allow delete: if request.auth != null;
    }
    match /padelos_events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.id == int(eventId);
      allow update: if request.auth != null && request.resource.data.id == int(eventId)
        && request.resource.data.communityId == resource.data.communityId;
      allow delete: if request.auth != null;
    }
    match /padelos_links/{document} {
      allow read: if request.auth != null;
      // Real incident, V0.11.49: a client-side race silently linked strangers' sign-ins to the
      // platform-owner profile (userId 1), handing them full Platform Admin rights. The app-level
      // fix removed the race itself, but this line is the actual backstop — no client write,
      // buggy or malicious, can EVER set userId to 1 here, full stop. The only way userId 1 can
      // ever be linked is the confirmEmailMatch Cloud Function (Admin SDK, bypasses these rules),
      // which is separately hard-locked to one specific email in functions/index.js.
      allow create, update: if request.auth != null && request.resource.data.userId != 1;
      allow delete: if request.auth != null;
    }
    match /fcmTokens/{document} {
      allow read, write: if request.auth != null;
    }
    match /padelos_backups/{document} {
      allow read, write: if request.auth != null;
    }
    match /padelos_audit/{document} {
      allow read, write: if request.auth != null;
    }
    // Written ONLY by the claimOrCreateProfile/confirmEmailMatch Cloud Functions (Admin SDK
    // bypasses these rules entirely) — the whole point is a uniqueness guarantee no client,
    // stale or otherwise, can corrupt by writing here directly. Read-only for clients.
    match /emailIndex/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
