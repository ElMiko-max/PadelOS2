rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /padelos/{document} {
      allow read, write: if request.auth != null;
    }
    match /padelos_links/{document} {
      allow read, write: if request.auth != null;
    }
    match /fcmTokens/{document} {
      allow read, write: if request.auth != null;
    }
    match /padelos_backups/{document} {
      allow read, write: if request.auth != null;
    }
    match /padelos_audit/{document} {
      allow read, write: if request.auth != null;
    }
    // Written ONLY by the claimOrCreateProfile/confirmEmailMatch Cloud Functions (Admin SDK
    // bypasses these rules entirely) — the whole point is a uniqueness guarantee no client,
    // stale or otherwise, can corrupt by writing here directly. Read-only for clients.
    match /emailIndex/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
