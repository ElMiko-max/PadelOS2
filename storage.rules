rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile-photos/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /event-photos/{eventId}/{photoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Community banner photos (admin-uploaded, replaces the default sport-gradient banner) —
    // added 2026-08-23. This path had no rule at all until now, so every upload attempt was
    // silently denied (found live: the upload hung/failed on both padelos-dev — no Storage
    // bucket provisioned there at all — and production, which had a working bucket but no rule
    // covering this specific path).
    match /community-banners/{commId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
